{
  "name": "mantle-intel-contracts",
  "version": "1.0.0",
  "description": "MantleIntelAudit smart contract",
  "scripts": {
    "compile": "npx hardhat compile",
    "deploy:testnet": "npx hardhat run scripts/deploy.js --network mantle_testnet",
    "deploy:mainnet": "npx hardhat run scripts/deploy.js --network mantle_mainnet",
    "verify": "npx hardhat verify"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "hardhat": "^2.22.0"
  },
  "allowScripts": {
    "keccak@3.0.4": true,
    "secp256k1@4.0.4": true
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "dotenv": "^17.4.2"
  }
}
