# ── Mantle Network ────────────────────────────────────────────────────────────
MANTLE_RPC_URL=https://rpc.mantle.xyz
MANTLE_TESTNET_RPC=https://rpc.sepolia.mantle.xyz
# MANTLE_RPC_URL=https://mantle-mainnet.g.alchemy.com/v2/YOUR_KEY

# ── Smart Contract ────────────────────────────────────────────────────────────
AUDIT_CONTRACT_ADDRESS=0xYourDeployedContractAddress
DEPLOYER_PRIVATE_KEY=0xYourDeployerPrivateKey
AGENT_PRIVATE_KEY=0xYourAgentWalletPrivateKey   # can be same as deployer for hackathon
MANTLESCAN_API_KEY=YourMantlescanApiKey

# ── AI / LLM ──────────────────────────────────────────────────────────────────
DASHSCOPE_API_KEY=sk-your-dashscope-key    # Qwen-Max via Alibaba DashScope
# QWEN_API_KEY=sk-your-key                  # alternate env name

# ── Telegram Bot ──────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id-or-channel-id

# ── App ───────────────────────────────────────────────────────────────────────
MNT_PRICE_USD=0.85        # approximate MNT price for USD conversion
POLL_INTERVAL=30          # seconds between pipeline cycles
BLOCKS_PER_CYCLE=100      # blocks to analyze per cycle
CONFIDENCE_THRESHOLD=0.60 # minimum confidence to emit a finding
