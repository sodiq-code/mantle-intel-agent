# ── Mantle Network ────────────────────────────────────────────────────────────
MANTLE_RPC_URL=https://rpc.mantle.xyz
MANTLE_TESTNET_RPC=https://rpc.sepolia.mantle.xyz
# MANTLE_RPC_URL=https://mantle-mainnet.g.alchemy.com/v2/YOUR_KEY

# ── Security & Authentication (Institutional Standard) ────────────────────────
API_KEY=your_secure_api_key_here               # Required to access backend and edge APIs
FRONTEND_URL=http://localhost:5173             # Strict CORS origin (no wildcards)

# ── Smart Contract & Keystore ─────────────────────────────────────────────────
AUDIT_CONTRACT_ADDRESS=0xYourDeployedContractAddress
# DEPLOYER_PRIVATE_KEY=0xYourDeployerPrivateKey  # Only used for Hardhat deployments
# AGENT_PRIVATE_KEY is removed for institutional security. Use Keystore instead.
KEYSTORE_PATH=./keystore.json
KEYSTORE_PASSWORD=your_secure_password         # In prod, fetch this from a Secret Manager
MANTLESCAN_API_KEY=YourMantlescanApiKey

# ── AI / LLM ──────────────────────────────────────────────────────────────────
DASHSCOPE_API_KEY=sk-your-dashscope-key    # Qwen-Max via Alibaba DashScope
# QWEN_API_KEY=sk-your-key                  # alternate env name

# ── Telegram Bot ──────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id-or-channel-id

# ── Discord ───────────────────────────────────────────────────────────────────
# Webhook (recommended — no bot token needed):
# 1. Discord server → Edit Channel → Integrations → Webhooks → New Webhook → Copy URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN
# Full slash-command bot (optional):
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_CHANNEL_ID=your_channel_id

# ── App ───────────────────────────────────────────────────────────────────────
MNT_PRICE_USD=0.85        # approximate MNT price for USD conversion
POLL_INTERVAL=30          # seconds between pipeline cycles
BLOCKS_PER_CYCLE=100      # blocks to analyze per cycle
CONFIDENCE_THRESHOLD=0.75 # minimum confidence to emit a finding
